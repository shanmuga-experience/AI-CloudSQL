# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials or API keys. This file must only ever contain
# placeholders.

# ---- GCP / Cloud SQL Admin API (for CPU/memory/storage metrics + real spec) ----
GCP_PROJECT_ID=your-gcp-project-id
CLOUDSQL_INSTANCE_ID=your-cloudsql-instance-name
# Path to a service account JSON key with roles/monitoring.viewer and
# roles/cloudsql.viewer. Leave unset to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Direct MySQL connection (e.g. via Cloud SQL Auth Proxy on 127.0.0.1) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=monitoring_user
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=information_schema

# ---- Fallback provisioned spec ----
# Used ONLY when the Cloud SQL Admin API is unreachable (missing creds,
# network, permissions). Set these to match your real instance so
# right-sizing/cost estimates stay meaningful.
INSTANCE_VCPUS=2
INSTANCE_MEMORY_GB=8
INSTANCE_STORAGE_GB=100
INSTANCE_HA=false

# ---- AI root-cause analysis (optional) ----
# Leave blank to disable — the rest of the dashboard works with zero setup.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CACHE_TTL_SECONDS=300

# ---- Collector behavior ----
POLL_INTERVAL_SECONDS=60
HTTP_PORT=8000
