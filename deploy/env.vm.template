# VM version of .env.template. Copy it to the project root as .env:
#   cp deploy/env.vm.template .env && nano .env
#
# Rules (config.py reads this file literally):
#   - no quotes needed, and NO comments at the end of a value line
#   - GOOGLE_APPLICATION_CREDENTIALS is intentionally absent: on the VM the
#     attached service account is used automatically (no key file)

# Cloud SQL instance NAME (not the PROJECT:REGION:INSTANCE connection name)
GCP_PROJECT_ID=your-gcp-project-id
CLOUDSQL_INSTANCE_ID=your-cloudsql-instance-name

# MySQL through the Cloud SQL Auth Proxy running on this VM
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=monitoring_user
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=information_schema

# Fallback spec, used only if the Cloud SQL Admin API is unreachable
INSTANCE_VCPUS=2
INSTANCE_MEMORY_GB=8
INSTANCE_STORAGE_GB=100
INSTANCE_HA=false

# Optional AI root-cause analysis (blank = off)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CACHE_TTL_SECONDS=300

# Collector
POLL_INTERVAL_SECONDS=60
HTTP_PORT=8000
